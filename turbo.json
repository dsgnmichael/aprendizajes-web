{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [
    ".env"
  ],
  "globalEnv": [
    "NODE_ENV",
    "NEXTAUTH_SECRET",
    "AUTH_SECRET",
    "MONGODB_URI",
    "BLOB_READ_WRITE_TOKEN",
    "MEDIA_PROVIDER",
    "GMAIL_CLIENT_ID",
    "GMAIL_CLIENT_SECRET",
    "GMAIL_REFRESH_TOKEN",
    "GMAIL_FROM_EMAIL"
  ],
  "globalPassThroughEnv": [
    "MONGODB_URI",
    "MONGODB_DB_NAME",
    "AUTH_SECRET",
    "PUBLIC_BASE_URL",
    "ADMIN_BASE_URL",
    "REVALIDATION_SECRET",
    "PREVIEW_SECRET",
    "MEDIA_PROVIDER",
    "LOCAL_MEDIA_DIR",
    "BLOB_READ_WRITE_TOKEN",
    "GOOGLE_MAPS_API_KEY",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GOOGLE_REDIRECT_URI",
    "INTEGRATION_ENCRYPTION_KEY",
    "CRON_SECRET",
    "NEXT_PUBLIC_GA_MEASUREMENT_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "GMAIL_CLIENT_ID",
        "GMAIL_CLIENT_SECRET",
        "GMAIL_REFRESH_TOKEN",
        "GMAIL_FROM_EMAIL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "build"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "outputs": [
        "coverage/**"
      ]
    }
  }
}