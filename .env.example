# =============================================================================
# Aprendizajess · Plataforma de perfiles profesionales
# Copy to `.env` (root). Both apps and the scripts read this file.
# Generate secrets with:  pnpm secrets:generate
# =============================================================================

# --- Database (required) ------------------------------------------------------
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
# Local (pnpm db:local): mongodb://127.0.0.1:27017
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=aprendizajess

# --- URLs ---------------------------------------------------------------------
# Public site (QR codes ALWAYS point here) and backoffice.
PUBLIC_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001

# --- Auth (admin) -------------------------------------------------------------
# Auth.js secret, >= 32 chars. Required by apps/admin.
AUTH_SECRET=
# Bootstrap super admin created/ensured by `pnpm db:seed` (never hardcoded).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# --- Cross-app security -------------------------------------------------------
# Shared by admin + web. HMAC for the private cache invalidation endpoint.
REVALIDATION_SECRET=
# Shared by admin + web. Signs short-lived draft preview tokens.
PREVIEW_SECRET=

# --- Media storage --------------------------------------------------------------
# local       -> files in ./.media served by the web app at /media/* (dev)
# vercel-blob -> Vercel Blob (requires BLOB_READ_WRITE_TOKEN)
MEDIA_PROVIDER=local
# Optional absolute path for local media (defaults to <repo>/.media)
LOCAL_MEDIA_DIR=
BLOB_READ_WRITE_TOKEN=

# --- Google Places API (New) – optional ------------------------------------------
# Server-only key (restrict it to the Places API + your server IPs).
GOOGLE_MAPS_API_KEY=

# --- Google Business Profile (OAuth 2.0) – optional ------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to ${ADMIN_BASE_URL}/api/integrations/google/callback
GOOGLE_REDIRECT_URI=
# base64 32-byte key used to encrypt OAuth refresh tokens at rest (AES-256-GCM).
INTEGRATION_ENCRYPTION_KEY=

# --- Scheduled sync ----------------------------------------------------------------
# Bearer secret for /api/cron/sync-reviews (Vercel Cron sends it automatically).
CRON_SECRET=

# --- Analytics – optional ------------------------------------------------------------
# GA4 can also be configured from the backoffice (Site settings).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
